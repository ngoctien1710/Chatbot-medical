#địa chỉ bind của Python RAG service
RAG_SERVICE_HOST=127.0.0.1
#cổng chạy FastAPI 
RAG_SERVICE_PORT=8001
#danh sách origin frontend được gọi API, ngăn bởi dấu phẩy
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

#URL của Ollama server
OLLAMA_BASE_URL=http://127.0.0.1:11434
#model generation sử dụng trong Ollama
OLLAMA_CHAT_MODEL=mistral
#model alias mặc định khi request không gửi model (mistral|gpt|gemini)
RAG_DEFAULT_CHAT_MODEL_ALIAS=mistral
#model OpenAI thực tế (thiết lập sau)
OPENAI_CHAT_MODEL=
#model Gemini thực tế (thiết lập sau)
GEMINI_CHAT_MODEL=
#API key OpenAI (thiết lập trong .env local)
OPENAI_API_KEY=
#API key Gemini (thiết lập trong .env local)
GEMINI_API_KEY=
#timeout gọi provider theo request (giây)
RAG_PROVIDER_TIMEOUT_SECONDS=45
#số lần retry thêm sau lần gọi đầu tiên
RAG_PROVIDER_RETRY_ATTEMPTS=2
#thời gian cooldown khi gặp rate limit/quota (giây)
RAG_RATE_LIMIT_COOLDOWN_SECONDS=60
#bật fallback về mistral khi provider cloud lỗi
RAG_FALLBACK_ON_PROVIDER_ERROR=true
#model embedding để index và dense retrieval
OLLAMA_EMBED_MODEL=Dqdung205/medical_vietnamese_embedding

#số chunk cuối cùng dùng làm context trả lời
RAG_TOP_K=3
#ngưỡng điểm lọc sau rerank
RAG_SCORE_THRESHOLD=0.35
# Retrieval mode options: hybrid_original | dense_only | sparse_only | hybrid_rrf | cross_encoder_only
RAG_RETRIEVAL_MODE=hybrid_original
#số candidate lấy từ mỗi nhánh trước khi fusion/rerank (dùng cho hybrid_original, hybrid_rrf).
RAG_RETRIEVAL_CANDIDATE_K=20
#hệ số k của RRF
RAG_RRF_K=60
#giới hạn số chunk cho cross_encoder_only
RAG_CROSS_ENCODER_MAX_SCAN_CHUNKS=2000

RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=180
RAG_CHUNK_TOKEN_SIZE=400
RAG_CHUNK_TOKEN_OVERLAP=80
#bỏ các chunk quá ngắn
RAG_MIN_CHUNK_CHARS=200
#nếu text extract quá ít thì kích hoạt OCR fallback
OCR_MIN_TEXT_CHARS=60
OCR_DPI=220

#bỏ phần mục lục
CLEAN_STRIP_TOC=true
#bỏ phần tài liệu tham khảo
CLEAN_STRIP_REFERENCES=true

#bật/tắt cleanup bằng GLM
GLM_CLEANUP_ENABLED=true
#model GLM dùng để cleanup
GLM_CLEANUP_MODEL=zai-org/GLM-5-FP8
#timeout mỗi lần gọi cleanup
GLM_CLEANUP_TIMEOUT_SECONDS=45
#độ dài tối đa mỗi đoạn cleanup
GLM_CLEANUP_MAX_CHUNK_CHARS=2800
#giới hạn số đoạn cleanup trên mỗi tài liệu
GLM_CLEANUP_MAX_CHUNKS_PER_DOC=12
# HF_TOKEN=hf_xxx

# Optional custom paths (defaults: project_root/data/* and project_root/Documents/VietNam)
# RAG_DATA_ROOT=D:/BAI_LAB/Chatbot-medical/data
# RAG_DATA_RAW_DIR=D:/BAI_LAB/Chatbot-medical/data/raw
# RAG_VECTOR_DB_DIR=D:/BAI_LAB/Chatbot-medical/data/chroma
# RAG_PDF_SOURCE_DIR=D:/BAI_LAB/Chatbot-medical/Documents/VietNam
# CHAT_LOG_ROOT=D:/BAI_LAB/Chatbot-medical/chat_log
RAG_REQUEST_TIMEOUT_SECONDS=120



