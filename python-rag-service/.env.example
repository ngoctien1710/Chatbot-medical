RAG_SERVICE_HOST=127.0.0.1
RAG_SERVICE_PORT=8001

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.35
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=180

# Optional custom paths (defaults already point to ../backend/data/*)
# RAG_DATA_RAW_DIR=F:/NGUYEN_LE_NAM/LAB/Chatbot-medical/backend/data/raw
# RAG_VECTOR_DB_DIR=F:/NGUYEN_LE_NAM/LAB/Chatbot-medical/backend/data/chroma
RAG_REQUEST_TIMEOUT_SECONDS=120
