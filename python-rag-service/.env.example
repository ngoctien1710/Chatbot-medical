RAG_SERVICE_HOST=127.0.0.1
RAG_SERVICE_PORT=8001
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=mistral
OLLAMA_EMBED_MODEL=Dqdung205/medical_vietnamese_embedding

RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.35
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=180
RAG_CHUNK_TOKEN_SIZE=400
RAG_CHUNK_TOKEN_OVERLAP=80
RAG_MIN_CHUNK_CHARS=200
OCR_MIN_TEXT_CHARS=60
OCR_DPI=220

CLEAN_STRIP_TOC=true
CLEAN_STRIP_REFERENCES=true

GLM_CLEANUP_ENABLED=true
GLM_CLEANUP_MODEL=zai-org/GLM-5-FP8
GLM_CLEANUP_TIMEOUT_SECONDS=45
GLM_CLEANUP_MAX_CHUNK_CHARS=2800
GLM_CLEANUP_MAX_CHUNKS_PER_DOC=12
# HF_TOKEN=hf_xxx

# Optional custom paths (defaults: project_root/data/* and project_root/Documents/VietNam)
# RAG_DATA_ROOT=D:/BAI_LAB/Chatbot-medical/data
# RAG_DATA_RAW_DIR=D:/BAI_LAB/Chatbot-medical/data/raw
# RAG_VECTOR_DB_DIR=D:/BAI_LAB/Chatbot-medical/data/chroma
# RAG_PDF_SOURCE_DIR=D:/BAI_LAB/Chatbot-medical/Documents/VietNam
# CHAT_LOG_ROOT=D:/BAI_LAB/Chatbot-medical/chat_log
RAG_REQUEST_TIMEOUT_SECONDS=120

